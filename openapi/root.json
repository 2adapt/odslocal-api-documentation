{
  "openapi": "3.2.0",
  "info"      : {
    "title": "ODSlocal API",
    "description": "Read access to the Indicators, Good Practices and Projects databases used for municipal SDG monitoring.",
    "version": "1.0.0"
  },
  "servers": [ {"url": "https://odslocal.pt/api/v4", "description": "Production (placeholder)"} ],
  "tags"      : [
    {"name": "Indicators",     "description": "SDG indicator values per municipality and year"},
    {"name": "Good Practices", "description": "Documented good practices linked to SDGs"      },
    {"name": "Projects",       "description": "Municipal projects linked to SDGs"             }
  ],
  "security": [ {"ApiKeyAuth": []} ],
  "paths"     : {
    "/indicators"         : {"$ref": "indicators.json#/list"      },
    "/indicators/{id}"    : {"$ref": "indicators.json#/detail"    },
    "/good-practices"     : {"$ref": "good-practices.json#/list"  },
    "/good-practices/{id}": {"$ref": "good-practices.json#/detail"},
    "/projects"           : {"$ref": "projects.json#/list"        },
    "/projects/{id}"      : {"$ref": "projects.json#/detail"      }
  },
  "components": {
    "securitySchemes": {
    "httpBearer": {
        "description": "Bearer token",
        "type": "http",
        "scheme": "Bearer"
      }
    },
    "schemas"        : {
      "Indicator"       : {"$ref": "indicators.json#/schemas/Indicator"           },
      "IndicatorList"   : {"$ref": "indicators.json#/schemas/IndicatorList"       },
      "GoodPractice"    : {"$ref": "good-practices.json#/schemas/GoodPractice"    },
      "GoodPracticeList": {"$ref": "good-practices.json#/schemas/GoodPracticeList"},
      "Project"         : {"$ref": "projects.json#/schemas/Project"               },
      "ProjectList"     : {"$ref": "projects.json#/schemas/ProjectList"           },
      "Pagination"      : {"$ref": "common.json#/schemas/Pagination"              },
      "Error"           : {"$ref": "common.json#/schemas/Error"                   }
    }
  }
}
