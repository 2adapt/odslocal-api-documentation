{
  "openapi": "3.2.0",
  "info"      : {
    "title": "ODSlocal API",
    "description": "Read access to databases used for municipal SDG monitoring: Indicators, Good Practices, Projects. Also, a list of Portuguese Municipalities with their respective DICO codes and general information on the SDGs, such as colour codes, logos, etc.",
    "version": "1.0.0"
  },
  "servers": [ {"url": "https://odslocal.pt/api/v4", "description": "Production (placeholder)"} ],
  "tags"      : [
    {"name": "Indicators",     "description": "SDG indicator values per municipality and year"                     },
    {"name": "Good Practices", "description": "Documented good practices linked to SDGs"                           },
    {"name": "Projects",       "description": "Municipal projects linked to SDGs"                                  },
    {"name": "Regions",        "description": "Lookup table for municipalities with respective DICO and NUTS codes"},
    {"name": "SDG info",       "description": "List of information on the sustainable develoment goals"            }
  ],
  "security": [ {"httpBearer": []} ],
  "paths"     : {
    "/indicators"         : {"$ref": "indicators.json#/list"      },
    "/indicators/{id}"    : {"$ref": "indicators.json#/detail"    },
    "/good-practices"     : {"$ref": "good-practices.json#/list"  },
    "/good-practices/{id}": {"$ref": "good-practices.json#/detail"},
    "/projects"           : {"$ref": "projects.json#/list"        },
    "/projects/{id}"      : {"$ref": "projects.json#/detail"      },
    "/regions"            : {"$ref": "regions.json#/list"         },
    "/SDG_info"           : {"$ref": "sdg_info.json#/list"        }
  },
  "components": {
    "securitySchemes": { "httpBearer": {"description": "Bearer token", "type": "http", "scheme": "Bearer"} },
    "schemas"        : {
      "Indicator"   : {"$ref": "indicators.json#/schemas/Indicator"       },
      "GoodPractice": {"$ref": "good-practices.json#/schemas/GoodPractice"},
      "Project"     : {"$ref": "projects.json#/schemas/Project"           },
      "Region"      : {"$ref": "regions.json#/schemas/Region"             },
      "SDG_info"    : {"$ref": "sdg_info.json#/schemas/SDG_info"          }
    }
  }
}
